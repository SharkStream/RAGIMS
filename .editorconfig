root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Frontend (React/TS) and data formats use 2-space indentation.
[*.{js,jsx,ts,tsx,css,scss,less,html,json,yaml,yml}]
indent_size = 2

# Markdown: trailing whitespace (two spaces) is meaningful for line breaks.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
