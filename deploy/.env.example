# Copy to `.env` in this directory (deploy/) to override docker-compose defaults.
# These variables are consumed by docker-compose interpolation (${VAR:-default});
# the backend's own config is documented separately in backend/.env.example.

# --- MySQL (infra) ---
MYSQL_ROOT_PASSWORD=ragims

# --- MinIO (infra) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- OpenAI (passed through to the backend container) ---
# REQUIRED by the backend: leave empty here and the app will fail fast at startup.
OPENAI__API_KEY=sk-REPLACE_ME
OPENAI__BASE_URL=https://api.openai.com/v1
OPENAI__EMBEDDING_MODEL=text-embedding-3-small
OPENAI__EMBEDDING_DIMENSION=1536
