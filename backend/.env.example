# Copy to `.env` and fill in real values. Keys use `__` as the nested-group
# delimiter (pydantic-settings env_nested_delimiter). Every key below maps to a
# field on `app.core.config.Settings`.
# Store raw passwords/secrets here (no URL encoding); config.py applies
# URL encoding itself when building DSNs/URLs.

# --- Application -----------------------------------------------------------
APP__NAME=RAGIMS
APP__VERSION=0.1.0
APP__ENV=development
APP__DEBUG=true
APP__LOG_LEVEL=INFO
APP__API_PREFIX=/api
# JSON array of allowed CORS origins.
APP__CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- MySQL 8 metadata DB (utf8mb4) ----------------------------------------
MYSQL__HOST=localhost
MYSQL__PORT=3306
MYSQL__USER=root
MYSQL__PASSWORD=ragims
MYSQL__DATABASE=ragims
MYSQL__CHARSET=utf8mb4
MYSQL__POOL_SIZE=10
MYSQL__POOL_RECYCLE=3600
MYSQL__ECHO=false

# --- Redis (Celery broker / result backend) --------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
# REDIS__PASSWORD=

# --- Qdrant vector DB ------------------------------------------------------
QDRANT__HOST=localhost
QDRANT__PORT=6333
# QDRANT__API_KEY=

# --- MinIO object storage --------------------------------------------------
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin
MINIO__SECURE=false
MINIO__BUCKET_RAW=raw-docs
MINIO__BUCKET_PARSED=parsed-text

# --- OpenAI embedding ------------------------------------------------------
# REQUIRED: missing this key raises a ValidationError at startup.
OPENAI__API_KEY=sk-REPLACE_ME
OPENAI__BASE_URL=https://api.openai.com/v1
OPENAI__EMBEDDING_MODEL=text-embedding-3-small
OPENAI__EMBEDDING_DIMENSION=1536
OPENAI__TIMEOUT=60.0
